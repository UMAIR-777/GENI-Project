<Subtask_Details>
    Subtask Name: "{{ step.step }}"
    Input: {{ step.input }}
    Output: {{ step.output }}
    Tags: {{ step.tags }}
    Description: {{ step.description }}
    spo: {{ spo_text }}
</Subtask_Details>

<Candidate_Nodes_List>
{{ candidate_list }}
</Candidate_Nodes_List>

<Matching_Guidelines>
    1. Return ONLY the exact node ID(s) from the candidate list as plain strings.
    2. Evaluate matches based on partially compatibility, or semantically equivalent match of inputs, outputs, tags, descriptions, and spo fields.
    3. Prioritize exact or partially or semantically or semantically relevant match.
    4. If no good match exists, return MISSING_NODE.
</Matching_Guidelines>

<Expected_JSON_Output_Format>
    Return ONLY a JSON object in one of these forms:
    {% raw %}{"SELECTED_NODE": ["<exact_node_id1>"]}{% endraw %}
    OR, if no candidate node is suitable or semantically relevant:
    {% raw %}{"MISSING_NODE": ["<subtask_name>"]}{% endraw %}
</Expected_JSON_Output_Format>

<FINAL_SELECTION_CRITERIA>
    - Must return ONLY the exact node ID(s) from the candidate list without any additional formatting
    - Must be a valid JSON object
    - Must contain either SELECTED_NODE or MISSING_NODE as the only key
    - The value must be a list containing exactly one string
</FINAL_SELECTION_CRITERIA>

{# Handle template escaping properly #}
{% raw %}
RETURN FORMAT:
{"SELECTED_NODE": ["node_id"]} or {"MISSING_NODE": ["subtask_name"]}
{% endraw %}